---
import Hero from "../components/Hero.astro";
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import Proyectos from "../components/Proyectos.astro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <meta name="viewport" content="width=device-width" />
    <Analytics />
    <SpeedInsights />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="W0uhnZleg-e21E5QbTvZyYukR8w1UkFtMl1B0nbkG2M" />
    <title>Miguel Fernández - Portfolio</title>
  </head>
  <body class="scroll-smooth overflow-x-hidden">
    <main class="w-full">
      <Hero />
      <Proyectos/>
    </main>
  </body>
</html>
