---
import Character from "../components/Character.astro";
import Experience from "../components/Experience.astro";
import Enlace from "../components/Enlace.astro";
---

<section
  class="relative max-w-200 min-h-screen pt-10 pb-24 md:pb-0 md:pt-0 m-auto flex md:gap-10 items-center flex-col justify-center md:flex-row gap-6"
>
  <div class="flex flex-1 flex-col gap-5 justify-center p-4 md:p-0">
    <h2 class="text-5xl font-bold font-base">Miguel <br />Fernández</h2>
    <p class="text-xl font-base">
      Soy un <strong>desarrollador web</strong> apasionado que se especializa en crear
      soluciones efectivas y creativas para problemas complejos. Me encanta <strong
        >aprender</strong
      > y
      <strong>mejorar</strong> mis habilidades constantemente.
    </p>
    <div class="flex flex-row gap-2">
      <Enlace
        image="/github-142-svgrepo-com.svg"
        link="https://github.com/miguifer/"
      />
    </div>
  </div>
  <div class="">
    <Character />
    <Experience />
  </div>

  <a
    href="#proyectos"
    class="absolute bottom-0 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-black hover:text-red/80 transition-colors cursor-pointer animate-bounce"
  >
    <span class="text-1xl text-center font-base">Proyectos</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>
