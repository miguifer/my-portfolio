---
import Character from "./Character.astro";
import Experience from "./Experience.astro";
import Enlace from "./Enlace.astro";
import SectionLink from "./SectionLink.astro";
---

<section
  class="relative max-w-200 min-h-screen pt-10 pb-24 md:pb-0 md:pt-0 m-auto flex md:gap-10 items-center flex-col justify-center md:flex-row gap-6"
>
  <div class="flex flex-1 flex-col gap-5 justify-center p-4 md:p-0">
    <h1 class="text-5xl font-bold font-base">Miguel <br />Fernández</h1>
    <p class="text-xl font-base">
      Soy un <strong>desarrollador web</strong> apasionado que se especializa en crear
      soluciones efectivas y creativas para problemas complejos. Me encanta <strong
        >aprender</strong
      > y
      <strong>mejorar</strong> mis habilidades constantemente.
    </p>
    <div class="flex flex-row gap-2">
      <Enlace
        image="/github-142-svgrepo-com.svg"
        link="https://github.com/miguifer/"
        alt="Perfil de GitHub de Miguel Fernández"
      />
    </div>
  </div>
  <div class="">
    <Character />
    <Experience />
  </div>

  <SectionLink href="#proyectos" label="Proyectos" />
</section>
