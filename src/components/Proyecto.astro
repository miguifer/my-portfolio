---
import type { Tecnologia } from "../types";
import Carousel from "./Carousel.astro";
import TechLink from "./TechLink.astro";
import Badge from "./Badge.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro";

interface Props {
  titulo: string;
  descripcion: string;
  repositorio?: string;
  demo?: string | string[];
  imagenes?: string | string[];
  icono?: string;
  tecnologias?: Tecnologia[];
  enDesarrollo?: boolean;
}

const {
  titulo,
  descripcion,
  repositorio,
  demo,
  imagenes,
  icono,
  tecnologias = [],
  enDesarrollo = false,
} = Astro.props;
---

<div class="transition-colors">
  <div class="flex flex-col md:flex-row gap-10">
    {
      imagenes && (
        <div class="w-full md:w-1/2 lg:w-3/5">
          <div class="relative w-full h-64 md:h-80 rounded-lg overflow-hidden border border-gray-300 bg-white">
            {Array.isArray(imagenes) ? (
              <Carousel imagenes={imagenes} titulo={titulo} />
            ) : (
              <img
                src={imagenes}
                alt={`${titulo} demo`}
                class="w-full h-full object-cover"
              />
            )}
          </div>
        </div>
      )
    }

    <div
      class={`w-full ${imagenes ? "md:w-1/2 lg:w-2/5" : ""} flex flex-col justify-center`}
    >
      {
        icono && (
          <img
            src={icono}
            alt={`${titulo} icono`}
            class="w-20 h-20 mb-4 object-contain"
          />
        )
      }
      <h3 class="text-2xl font-semibold font-base mb-1">{titulo}</h3>
      {enDesarrollo && <Badge text="En desarrollo" />}
      <p class="text-xl font-base mb-4" set:html={descripcion} />

      {
        tecnologias.length > 0 && (
          <div class="flex flex-wrap gap-3 mb-4">
            {tecnologias.map((tech) => (
              <TechLink tech={tech} />
            ))}
          </div>
        )
      }

      <div class="flex gap-3">
        {
          repositorio && (
            <a
              href={repositorio}
              target="_blank"
              rel="noopener noreferrer"
              class="flex font-base items-center gap-1 text-sm text-gray-500 hover:text-red transition-colors"
            >
              <GitHubIcon />
              Repositorio
            </a>
          )
        }
        {
          demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="flex font-base items-center gap-1 text-sm text-gray-500 hover:text-red transition-colors"
            >
              <ExternalLinkIcon />
              Ver proyecto
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
