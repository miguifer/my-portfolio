---
interface Tecnologia {
  nombre: string;
  logo: string;
  url: string;
}

interface Props {
  titulo: string;
  descripcion: string;
  repositorio?: string;
  demo?: string;
  imagen?: string;
  tecnologias?: Tecnologia[];
  enDesarrollo?: boolean;
}

const {
  titulo,
  descripcion,
  repositorio,
  demo,
  tecnologias = [],
  enDesarrollo = false,
} = Astro.props;
---

<div class="transition-colors">
  <div class="flex flex-col md:flex-row gap-10">

    {demo && (
      <div class="w-full md:w-1/2 lg:w-3/5">
        <div class="relative w-full h-64 md:h-80 rounded-lg overflow-hidden border border-gray-300 bg-white">
          <iframe
            src={demo}
            title={titulo}
            class="absolute inset-0 w-[200%] h-[200%] origin-top-left scale-50"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    )}

    <div class={`w-full ${demo ? 'md:w-1/2 lg:w-2/5' : ''} flex flex-col justify-center`}>
      <h3 class="text-2xl font-semibold font-base mb-1">{titulo}</h3>
      {enDesarrollo && (
        <span class="inline-block w-fit bg-yellow-200 text-yellow-800 text-xs font-base px-2 py-1 rounded-full mb-2">
          En desarrollo
        </span>
      )}
      <p class="text-xl font-base mb-4" set:html={descripcion}></p>

      {tecnologias.length > 0 && (
        <div class="flex flex-wrap gap-3 mb-4">
          {tecnologias.map((tech) => (
            <a
              href={tech.url}
              target="_blank"
              rel="noopener noreferrer"
              title={tech.nombre}
              class="w-8 h-8 hover:scale-110 transition-transform"
            >
              <img
                src={tech.logo}
                alt={tech.nombre}
                class="w-full h-full object-contain"
              />
            </a>
          ))}
        </div>
      )}

      <div class="flex gap-3">
        {repositorio && (
          <a
            href={repositorio}
            target="_blank"
            rel="noopener noreferrer"
            class="flex font-base items-center gap-1 text-sm text-gray-500 hover:text-red transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            Repositorio
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="flex font-base items-center gap-1 text-sm text-gray-500 hover:text-red transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Ver proyecto
          </a>
        )}
      </div>
    </div>
  </div>
</div>
