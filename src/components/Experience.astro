---
import Enlace from "./Enlace.astro";
import { calcularTiempoExperiencia } from "../utils/dates";

const timeString = calcularTiempoExperiencia(new Date("2025-03-01"));
---

<p class="pt-2 text-1xl text-center font-base flex flex-row justify-center items-center gap-2" id="experiencia">
  <strong>experiencia </strong>
  {timeString}

  <Enlace
    image="/icons/linkedin.svg"
    link="https://www.linkedin.com/in/miguel-fern%C3%A1ndez-fernandez/"
    alt="Perfil de LinkedIn de Miguel Fernández"
    size={20}
  />
</p>
