---
export interface Props {
  class?: string;
}

const { class: className = "w-4 h-4" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="2.5"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    d="M15 19l-7-7 7-7"
  />
</svg>
