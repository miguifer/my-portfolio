---
import Proyecto from "../components/Proyecto.astro";

interface Tecnologia {
  nombre: string;
  logo: string;
  url: string;
}

interface ProyectoData {
  titulo: string;
  descripcion: string;
  repositorio?: string;
  demo?:  string;
  imagenes?:  string | string[];
  icono?: string;
  tecnologias: Tecnologia[];
  enDesarrollo?: boolean;
}

const proyectos: ProyectoData[] = [
  {
    titulo: "Afipiti",
    descripcion: "Aplicación web desarrollada con <strong>Next.js</strong>, integrada con <strong>Sanity</strong> como sistema de gestión de contenido headless.",
    repositorio: "https://github.com/miguifer/afipiti",
    demo: "https://afipiti.com",
    imagenes: ["/proyectos/afipiti/1.png", '/proyectos/afipiti/2.png'],
    tecnologias: [
      { nombre: "Next.js", logo: "next.svg", url: "https://nextjs.org" },
      { nombre: "Sanity", logo: "sanity.svg", url: "https://sanity.io" },
      { nombre: "Tailwind CSS", logo: "tailwind.svg", url: "https://tailwindcss.com" },
      { nombre: "Resend", logo: "resend.svg", url: "https://resend.com" },
    ],
    enDesarrollo: false,
  },
    {
      titulo: "Scrollvideo",
      descripcion: "Plugin para WordPress que permite reproducir videos sincronizados con el scroll.",
      repositorio: "https://github.com/miguifer/scrollvideo",
      demo: "https://wordpress.org/plugins/sleek-scroll-video/",
      icono: "/proyectos/scrollvideo/icon.png",
      tecnologias: [
        { nombre: "WordPress", logo: "wordpress.svg", url: "https://wordpress.org" },
        { nombre: "Apache Subversion", logo: "Apache_Subversion_logo.svg", url: "https://subversion.apache.org/" }
      ],
      enDesarrollo: false,
    },
];
---

<section id="proyectos" class="max-w-200 min-h-screen pt-16 pb-20 md:pb-0 md:pt-0 m-auto flex flex-col justify-center p-4 md:p-0">
  <h2 class="text-5xl font-bold font-base mb-10">Proyectos</h2>
  <div class="flex flex-col gap-8">
    {proyectos.map((proyecto, idx) => (
      <>
        <Proyecto
          titulo={proyecto.titulo}
          descripcion={proyecto.descripcion}
          repositorio={proyecto.repositorio}
          demo={proyecto.demo}
          imagenes={proyecto.imagenes}
          icono={proyecto.icono}
          tecnologias={proyecto.tecnologias}
          enDesarrollo={proyecto.enDesarrollo}
        />
        {idx < proyectos.length - 1 && (
          <hr class="border-t border-gray-200 my-4 opacity-60" />
        )}
      </>
    ))}
  </div>
</section>
