---
import Proyecto from "./Proyecto.astro";
import SectionLink from "./SectionLink.astro";
import { proyectos } from "../data/proyectos";
---

<section id="proyectos" aria-label="Proyectos" class="relative max-w-200 min-h-screen pt-16 pb-24 md:pb-0 md:pt-0 m-auto flex flex-col justify-center p-4 md:p-0">
  <h2 class="text-5xl font-bold font-base mb-10">Proyectos</h2>
  <div class="flex flex-col gap-8">
    {proyectos.map((proyecto, idx) => (
      <>
        <Proyecto
          titulo={proyecto.titulo}
          descripcion={proyecto.descripcion}
          repositorio={proyecto.repositorio}
          demo={proyecto.demo}
          imagenes={proyecto.imagenes}
          icono={proyecto.icono}
          tecnologias={proyecto.tecnologias}
          enDesarrollo={proyecto.enDesarrollo}
        />
        {idx < proyectos.length - 1 && (
          <hr class="border-t border-gray-200 my-4 opacity-60" />
        )}
      </>
    ))}
  </div>

  <!-- <SectionLink href="#cv" label="Experiencia" /> -->
</section>
